#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

int main(void)
{
    double score1, score2, score3;
    double weight1, weight2, weight3;
    double weightSum, average;

    printf("세 과목의 점수 입력: ");
    if (scanf("%lf %lf %lf", &score1, &score2, &score3) != 3) {
        printf("입력 오류입니다.\n");
        return 1;
    }

    printf("각 과목의 가중치 입력: ");
    if (scanf("%lf %lf %lf", &weight1, &weight2, &weight3) != 3) {
        printf("입력 오류입니다.\n");
        return 1;
    }

    if (score1 < 0 || score1 > 100 ||
        score2 < 0 || score2 > 100 ||
        score3 < 0 || score3 > 100) {
        printf("점수는 0∼100 사이여야 합니다.\n");
        return 1;
    }

    weightSum = weight1 + weight2 + weight3;

    if (weight1 < 0 || weight2 < 0 || weight3 < 0 ||
        weightSum <= 0) {
        printf("가중치는 음수일 수 없고, 합은 0보다 커야 합니다.\n");
        return 1;
    }

    average = (score1 * weight1 +
               score2 * weight2 +
               score3 * weight3) / weightSum;

    printf("가중평균: %.2f점\n", average);

    return 0;
}
