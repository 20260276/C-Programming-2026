#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

int main(void)
{
    int money;

    printf("금액 입력(원): ");
    if (scanf("%d", &money) != 1 || money < 0) {
        printf("0 이상의 정수를 입력하세요.\n");
        return 1;
    }

    printf("50000원: %d개\n", money / 50000);
    money %= 50000;

    printf("10000원: %d개\n", money / 10000);
    money %= 10000;

    printf("5000원: %d개\n", money / 5000);
    money %= 5000;

    printf("1000원: %d개\n", money / 1000);
    money %= 1000;

    printf("500원: %d개\n", money / 500);
    money %= 500;

    printf("100원: %d개\n", money / 100);
    money %= 100;

    printf("50원: %d개\n", money / 50);
    money %= 50;

    printf("10원: %d개\n", money / 10);
    money %= 10;

    printf("5원: %d개\n", money / 5);
    money %= 5;

    printf("1원: %d개\n", money);

    return 0;
}
